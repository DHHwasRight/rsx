{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "RSX",
  "scopeName": "source.rsx",
  "fileTypes": [
    "rsx"
  ],
  "patterns": [
    {
      "include": "#component"
    },
    {
      "include": "source.rust"
    }
  ],
  "repository": {
    "component": {
      "begin": "^(\\s*)((?:pub(?:\\s*\\([^)]*\\))?\\s+)?)(fn)\\s+([A-Z][A-Za-z0-9_]*)",
      "beginCaptures": {
        "2": {
          "name": "storage.modifier.visibility.rust"
        },
        "3": {
          "name": "keyword.other.fn.rust"
        },
        "4": {
          "name": "entity.name.function.component.rsx"
        }
      },
      "end": "^\\1(\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.brackets.curly.rust"
        }
      },
      "name": "meta.function.component.rsx",
      "patterns": [
        {
          "include": "#signature"
        },
        {
          "include": "#markup"
        }
      ]
    },
    "signature": {
      "begin": "\\G(?=\\s*[<(])",
      "end": "(\\{)\\s*$",
      "endCaptures": {
        "1": {
          "name": "punctuation.brackets.curly.rust"
        }
      },
      "patterns": [
        {
          "include": "source.rust"
        }
      ]
    },
    "markup": {
      "patterns": [
        {
          "include": "#line-comment"
        },
        {
          "include": "#doctype"
        },
        {
          "include": "#html-comment"
        },
        {
          "include": "#match"
        },
        {
          "include": "#control"
        },
        {
          "include": "#statement"
        },
        {
          "include": "#style-line"
        },
        {
          "include": "#script-line"
        },
        {
          "include": "#style"
        },
        {
          "include": "#script"
        },
        {
          "include": "#fragment"
        },
        {
          "include": "#component-tag"
        },
        {
          "include": "#html-tag"
        },
        {
          "include": "#closing-tag"
        },
        {
          "include": "#interpolation"
        },
        {
          "include": "#entity"
        }
      ]
    },
    "line-comment": {
      "match": "^\\s*((//).*)$",
      "captures": {
        "1": {
          "name": "comment.line.double-slash.rsx"
        },
        "2": {
          "name": "punctuation.definition.comment.rsx"
        }
      }
    },
    "doctype": {
      "match": "(<!)(DOCTYPE|doctype)(\\s+[^>]*)?(>)",
      "name": "meta.tag.metadata.doctype.html",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        },
        "3": {
          "name": "entity.other.attribute-name.html"
        },
        "4": {
          "name": "punctuation.definition.tag.end.html"
        }
      }
    },
    "html-comment": {
      "begin": "<!--",
      "end": "-->",
      "name": "comment.block.html",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.html"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.html"
        }
      }
    },
    "control": {
      "begin": "(?:^|(?<=\\}))\\s*\\b(else\\s+if|if|else|for|while|loop)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.rust"
        }
      },
      "end": "^\\s*(\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.brackets.curly.rust"
        }
      },
      "name": "meta.block.control.rsx",
      "patterns": [
        {
          "include": "#control-head"
        },
        {
          "include": "#markup"
        }
      ]
    },
    "control-head": {
      "begin": "\\G(?!\\s*$)",
      "end": "(\\{)\\s*$",
      "endCaptures": {
        "1": {
          "name": "punctuation.brackets.curly.rust"
        }
      },
      "patterns": [
        {
          "include": "source.rust"
        }
      ]
    },
    "match": {
      "begin": "^\\s*\\b(match)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.rust"
        }
      },
      "end": "^\\s*(\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.brackets.curly.rust"
        }
      },
      "name": "meta.block.match.rsx",
      "patterns": [
        {
          "include": "#control-head"
        },
        {
          "include": "#line-comment"
        },
        {
          "include": "#match-arm"
        }
      ]
    },
    "match-arm": {
      "begin": "^\\s*(?!\\}|//)(?=.*=>)",
      "end": "(,)\\s*$|(?=^\\s*\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.comma.rust"
        }
      },
      "name": "meta.match-arm.rsx",
      "patterns": [
        {
          "begin": "\\G",
          "end": "(=>)",
          "endCaptures": {
            "1": {
              "name": "keyword.operator.arrow.fat.rust"
            }
          },
          "patterns": [
            {
              "include": "source.rust"
            }
          ]
        },
        {
          "include": "#markup"
        }
      ]
    },
    "statement": {
      "begin": "^\\s*(?=(?:let|const|return|break|continue)\\b)",
      "end": ";\\s*$",
      "patterns": [
        {
          "include": "source.rust"
        }
      ]
    },
    "style": {
      "begin": "(<)(style)\\b",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        }
      },
      "end": "(</)(style)\\s*(>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        },
        "3": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "patterns": [
        {
          "begin": "\\G",
          "end": "(>)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.end.html"
            }
          },
          "patterns": [
            {
              "include": "#attributes"
            }
          ]
        },
        {
          "begin": "(?<=>)",
          "end": "(?=</style\\s*>)",
          "contentName": "meta.embedded.block.css source.css",
          "patterns": [
            {
              "include": "#raw-interpolation"
            },
            {
              "include": "source.css"
            }
          ]
        }
      ]
    },
    "script": {
      "begin": "(<)(script)\\b",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        }
      },
      "end": "(</)(script)\\s*(>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        },
        "3": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "patterns": [
        {
          "begin": "\\G",
          "end": "(>)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.end.html"
            }
          },
          "patterns": [
            {
              "include": "#attributes"
            }
          ]
        },
        {
          "begin": "(?<=>)",
          "end": "(?=</script\\s*>)",
          "contentName": "meta.embedded.block.javascript source.js",
          "patterns": [
            {
              "include": "#raw-interpolation"
            },
            {
              "include": "source.js"
            }
          ]
        }
      ]
    },
    "script-line": {
      "match": "(<)(script)\\b([^>]*)(>)(.*?)(</)(script)\\s*(>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        },
        "3": {
          "patterns": [
            {
              "include": "#attributes"
            }
          ]
        },
        "4": {
          "name": "punctuation.definition.tag.end.html"
        },
        "5": {
          "name": "meta.embedded.block.javascript source.js",
          "patterns": [
            {
              "include": "#raw-interpolation"
            },
            {
              "include": "source.js"
            }
          ]
        },
        "6": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "7": {
          "name": "entity.name.tag.html"
        },
        "8": {
          "name": "punctuation.definition.tag.end.html"
        }
      }
    },
    "style-line": {
      "match": "(<)(style)\\b([^>]*)(>)(.*?)(</)(style)\\s*(>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        },
        "3": {
          "patterns": [
            {
              "include": "#attributes"
            }
          ]
        },
        "4": {
          "name": "punctuation.definition.tag.end.html"
        },
        "5": {
          "name": "meta.embedded.block.css source.css",
          "patterns": [
            {
              "include": "#raw-interpolation"
            },
            {
              "include": "source.css"
            }
          ]
        },
        "6": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "7": {
          "name": "entity.name.tag.html"
        },
        "8": {
          "name": "punctuation.definition.tag.end.html"
        }
      }
    },
    "fragment": {
      "match": "(</?)(>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.begin.rsx"
        },
        "2": {
          "name": "punctuation.definition.tag.end.rsx"
        }
      }
    },
    "component-tag": {
      "begin": "(<)([A-Z][\\w.:]*)(?=[\\s/>])",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.rsx"
        },
        "2": {
          "name": "support.class.component.rsx"
        }
      },
      "end": "(/?>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.rsx"
        }
      },
      "name": "meta.tag.component.rsx",
      "patterns": [
        {
          "include": "#attributes"
        }
      ]
    },
    "html-tag": {
      "begin": "(<)([a-z][\\w:.-]*)(?=[\\s/>])",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        }
      },
      "end": "(/?>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "name": "meta.tag.html.rsx",
      "patterns": [
        {
          "include": "#attributes"
        }
      ]
    },
    "closing-tag": {
      "patterns": [
        {
          "match": "(</)([A-Z][\\w.:]*)\\s*(>)",
          "captures": {
            "1": {
              "name": "punctuation.definition.tag.begin.rsx"
            },
            "2": {
              "name": "support.class.component.rsx"
            },
            "3": {
              "name": "punctuation.definition.tag.end.rsx"
            }
          }
        },
        {
          "match": "(</)([a-z][\\w:.-]*)\\s*(>)",
          "captures": {
            "1": {
              "name": "punctuation.definition.tag.begin.html"
            },
            "2": {
              "name": "entity.name.tag.html"
            },
            "3": {
              "name": "punctuation.definition.tag.end.html"
            }
          }
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "include": "#spread"
        },
        {
          "match": "([A-Za-z_@][\\w:.-]*)(\\?)?(?=\\s*=)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.html"
            },
            "2": {
              "name": "keyword.operator.optional.rsx"
            }
          }
        },
        {
          "match": "[A-Za-z_@][\\w:.-]*",
          "name": "entity.other.attribute-name.html"
        },
        {
          "match": "=",
          "name": "punctuation.separator.key-value.html"
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.html",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.html"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.html"
            }
          }
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.html"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "spread": {
      "begin": "(\\{)\\s*(\\.\\.\\.)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.embedded.begin.rsx"
        },
        "2": {
          "name": "keyword.operator.spread.rsx"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.rsx"
        }
      },
      "contentName": "meta.embedded.expression.rust",
      "patterns": [
        {
          "include": "#braces"
        },
        {
          "include": "source.rust"
        }
      ]
    },
    "interpolation": {
      "begin": "(\\{)(!)?",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.embedded.begin.rsx"
        },
        "2": {
          "name": "keyword.operator.unescaped.rsx"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.rsx"
        }
      },
      "contentName": "meta.embedded.expression.rust",
      "patterns": [
        {
          "include": "#braces"
        },
        {
          "include": "source.rust"
        }
      ]
    },
    "raw-interpolation": {
      "begin": "(\\{)(!)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.embedded.begin.rsx"
        },
        "2": {
          "name": "keyword.operator.unescaped.rsx"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.rsx"
        }
      },
      "contentName": "meta.embedded.expression.rust",
      "patterns": [
        {
          "include": "#braces"
        },
        {
          "include": "source.rust"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.brackets.curly.rust"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.brackets.curly.rust"
        }
      },
      "patterns": [
        {
          "include": "#braces"
        },
        {
          "include": "source.rust"
        }
      ]
    },
    "entity": {
      "match": "&(?:[A-Za-z][A-Za-z0-9]+|#\\d+|#x[0-9A-Fa-f]+);",
      "name": "constant.character.entity.html"
    }
  }
}
