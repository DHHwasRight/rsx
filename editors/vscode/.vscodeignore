# Everything that is not needed to run the extension.
#
# node_modules is deliberately NOT listed: `vsce` already drops
# devDependencies, and hand-listing the runtime ones is how a transitive
# dependency goes missing. That happened — `minimatch`, reached through the
# language client, was left out and the installed extension failed to
# activate with nothing but a stack of module paths.
.vscode/**
.vscode-test/**
test/**
scripts/**
*.vsix
.gitignore
