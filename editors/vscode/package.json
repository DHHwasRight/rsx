{
  "name": "rsx",
  "displayName": "RSX Templates",
  "description": "Language support for .rsx templates: highlighting, diagnostics, hover, completion and go to definition.",
  "version": "0.1.0",
  "publisher": "rsx",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:rsx"],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "rsx",
        "extensions": [".rsx"],
        "aliases": ["RSX"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rsx",
        "scopeName": "source.rsx",
        "path": "./syntaxes/rsx.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "RSX",
      "properties": {
        "rsx.server.path": {
          "type": "string",
          "default": "rsx",
          "description": "Path to the rsx binary that provides the language server."
        },
        "rsx.server.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Run the rsx language server. Turn this off to keep syntax highlighting only."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0"
  }
}
